# Copy to .env and fill in. .env is gitignored: never commit real secrets.

# API key for every /api/* call except /api/health (header X-API-Key or ?token=).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(24))"
TRUST_IDS_TOKEN=change-me

TRUST_IDS_MAX_RUNS=2
BACKEND_PORT=8765
APP_PORT=8501
BACKEND_MEM=1g
APP_MEM=1g
# what browsers use to reach the backend (links from the app to /live)
PUBLIC_BACKEND_URL=http://localhost:8765

# --- public server only (docker-compose.prod.yml) ---
APP_DOMAIN=ids.example.com
API_DOMAIN=ids-api.example.com
BASIC_AUTH_USER=reviewer
# hash: docker run --rm caddy:2.8.4-alpine caddy hash-password --plaintext 'your-password'
# (in .env, write every $ in the hash as $$)
BASIC_AUTH_HASH=
